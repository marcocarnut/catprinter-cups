"""CUPS filter: CUPS raster -> ESC/POS for YHK / JieLi "cat" thermal printers.

The printer has a 384-dot (48 mm @ 203 dpi) head, no built-in font and
ignores the ESC/POS heat/density commands, so every page is sent as a
1-bit GS v 0 raster image.  The printer ignores ESC J / ESC d / LF, so
paper is fed by sending blank raster rows.

Usage (as invoked by CUPS): rastertoyhk job user title copies options [file]

Options (from the PPD, passed in argv[5] or taken from the PPD defaults):
  FeedAfter=<n>mm   paper fed at the end of the job so the label clears
                    the tear bar (default 10mm)
  PageGap=<n>mm     blank paper between pages/labels (default 4mm)
  Dither=FloydSteinberg|Threshold
"""

import os
import re
import struct
import sys

HEAD_DOTS = 384
BYTES_PER_ROW = HEAD_DOTS // 8
DOTS_PER_MM = 8
ROWS_PER_CHUNK = 32
HEADER_SIZE = 1796

# cups_cspace_t values we understand
CSPACE_W, CSPACE_K, CSPACE_SW = 0, 3, 18


def log(level, msg):
    sys.stderr.write(f"{level}: rastertoyhk: {msg}\n")
    sys.stderr.flush()


def ppd_defaults():
    """Read *Default<Option> values from the job's PPD."""
    path = os.environ.get("PPD")
    defaults = {}
    if path:
        try:
            with open(path, encoding="latin-1") as f:
                for line in f:
                    m = re.match(r"\*Default(\w+):\s*(\S+)", line)
                    if m:
                        defaults[m.group(1)] = m.group(2)
        except OSError:
            pass
    return defaults


def parse_options(optstr):
    opts = {}
    for tok in optstr.split():
        if "=" in tok:
            k, v = tok.split("=", 1)
            opts[k] = v
        else:
            opts[tok] = "true"
    return opts


def mm_option(opts, name, default_mm):
    v = opts.get(name, f"{default_mm}mm")
    m = re.fullmatch(r"(\d+(?:\.\d+)?)(mm)?", v)
    if not m:
        log("WARNING", f"bad {name} value {v!r}, using {default_mm}mm")
        return default_mm * DOTS_PER_MM
    return int(float(m.group(1)) * DOTS_PER_MM)


# ---------------------------------------------------------------- raster in

def read_exact(f, n):
    buf = f.read(n)
    if buf is None or len(buf) < n:
        return None
    return buf


class RasterReader:
    """Minimal reader for CUPS raster v1/v2/v3 streams."""

    def __init__(self, f):
        self.f = f
        sync = read_exact(f, 4)
        # The sync word is a native-order uint32 0x52615332/3 ("RaS2"/"RaS3"
        # when read big-endian), so "2SaR"/"3SaR" on disk means little-endian.
        if sync in (b"2SaR", b"3SaR", b"tSaR"):
            self.endian = "<"
        elif sync in (b"RaS2", b"RaS3", b"RaSt"):
            self.endian = ">"
        else:
            raise ValueError(f"not a CUPS raster stream (sync {sync!r})")
        self.compressed = sync in (b"RaS2", b"2SaR")

    def pages(self):
        while True:
            hdr = read_exact(self.f, HEADER_SIZE)
            if hdr is None:
                return
            u = lambda off: struct.unpack_from(self.endian + "I", hdr, off)[0]
            page = {
                "width": u(372),
                "height": u(376),
                "bits_per_color": u(384),
                "bits_per_pixel": u(388),
                "bytes_per_line": u(392),
                "color_space": u(400),
            }
            yield page, self._rows(page)

    def _rows(self, page):
        bpl = page["bytes_per_line"]
        if not self.compressed:
            for _ in range(page["height"]):
                row = read_exact(self.f, bpl)
                if row is None:
                    raise EOFError("truncated raster data")
                yield row
            return
        # RaS2 run-length encoding: per line a repeat count, then
        # pixel runs (0..127 = repeat next pixel n+1 times,
        # 128..255 = 257-n literal pixels).
        pixel = max(1, (page["bits_per_pixel"] + 7) // 8)
        y = 0
        while y < page["height"]:
            rep = read_exact(self.f, 1)
            if rep is None:
                raise EOFError("truncated raster data")
            row = bytearray()
            while len(row) < bpl:
                n = self.f.read(1)[0]
                if n < 128:
                    row += read_exact(self.f, pixel) * (n + 1)
                else:
                    row += read_exact(self.f, pixel * (257 - n))
            row = bytes(row[:bpl])
            for _ in range(rep[0] + 1):
                if y < page["height"]:
                    yield row
                    y += 1


def to_darkness(row, page):
    """Return a list of 0..255 darkness values (255 = black), one per dot,
    cropped or padded to the head width and centred."""
    w, bpc, cs = page["width"], page["bits_per_color"], page["color_space"]
    if bpc == 8:
        vals = list(row[:w])
        if cs in (CSPACE_W, CSPACE_SW):
            vals = [255 - v for v in vals]
    elif bpc == 1:
        vals = [(row[x >> 3] >> (7 - (x & 7))) & 1 for x in range(w)]
        black = 1 if cs == CSPACE_K else 0
        vals = [255 if v == black else 0 for v in vals]
    else:
        raise ValueError(f"unsupported cupsBitsPerColor {bpc}")
    if w > HEAD_DOTS:
        off = (w - HEAD_DOTS) // 2
        vals = vals[off:off + HEAD_DOTS]
    elif w < HEAD_DOTS:
        left = (HEAD_DOTS - w) // 2
        vals = [0] * left + vals + [0] * (HEAD_DOTS - w - left)
    return vals


# ------------------------------------------------------------- dithering

def threshold(rows):
    for vals in rows:
        yield [v >= 128 for v in vals]


def floyd_steinberg(rows):
    err_next = [0] * (HEAD_DOTS + 2)
    for vals in rows:
        err = err_next
        err_next = [0] * (HEAD_DOTS + 2)
        out = [False] * HEAD_DOTS
        for x in range(HEAD_DOTS):
            v = vals[x] + err[x + 1] // 16
            if v >= 128:
                out[x] = True
                e = v - 255
            else:
                e = v
            err[x + 2] += e * 7
            err_next[x] += e * 3
            err_next[x + 1] += e * 5
            err_next[x + 2] += e
        yield out


def pack(bits):
    row = bytearray(BYTES_PER_ROW)
    for x, b in enumerate(bits):
        if b:
            row[x >> 3] |= 0x80 >> (x & 7)
    return bytes(row)


# ------------------------------------------------------------ ESC/POS out

def raster(rows):
    n = len(rows)
    return (b"\x1dv0\x00" + struct.pack("<HH", BYTES_PER_ROW, n)
            + b"".join(rows))


def feed(dots):
    """Advance the paper.  The printer ignores ESC J / ESC d / LF, so
    paper is moved by printing blank raster rows."""
    blank = bytes(BYTES_PER_ROW)
    out = bytearray()
    while dots > 0:
        n = min(dots, ROWS_PER_CHUNK)
        out += raster([blank] * n)
        dots -= n
    return bytes(out)


def emit_page(out, packed_rows):
    pending = []
    for row in packed_rows:
        pending.append(row)
        if len(pending) == ROWS_PER_CHUNK:
            out.write(raster(pending))
            pending = []
    if pending:
        out.write(raster(pending))


def main():
    if len(sys.argv) not in (6, 7):
        sys.stderr.write("Usage: rastertoyhk job user title copies "
                         "options [file]\n")
        return 1

    opts = ppd_defaults()
    opts.update(parse_options(sys.argv[5]))
    feed_after = mm_option(opts, "FeedAfter", 10)
    page_gap = mm_option(opts, "PageGap", 4)
    dither = (floyd_steinberg
              if opts.get("Dither", "FloydSteinberg") == "FloydSteinberg"
              else threshold)

    src = open(sys.argv[6], "rb") if len(sys.argv) == 7 else sys.stdin.buffer
    out = sys.stdout.buffer

    try:
        reader = RasterReader(src)
    except ValueError as e:
        log("ERROR", str(e))
        return 1

    out.write(b"\x1b@")  # initialise
    npages = 0
    for page, rows in reader.pages():
        npages += 1
        log("INFO", f"Printing page {npages}")
        sys.stderr.write(f"PAGE: {npages} 1\n")
        if npages > 1:
            out.write(feed(page_gap))
        darkness = (to_darkness(r, page) for r in rows)
        emit_page(out, (pack(b) for b in dither(darkness)))
        out.flush()

    out.write(feed(feed_after))
    out.flush()
    if npages == 0:
        log("ERROR", "no pages found in raster stream")
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
